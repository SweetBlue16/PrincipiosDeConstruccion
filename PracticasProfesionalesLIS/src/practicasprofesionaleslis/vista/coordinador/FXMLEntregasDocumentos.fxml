<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="practicasprofesionaleslis.controlador.coordinador.FXMLBuscarProyectoController">
    <children>
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#18529d" height="66.0" stroke="#18529d" strokeType="INSIDE" width="700.0" />
        <Label layoutX="14.0" layoutY="10.0" prefHeight="46.0" prefWidth="505.0" text="Buscar Estudiante" textFill="WHITE">
            <font>
                <Font name="Gill Sans MT" size="26.0" />
            </font>
        </Label>
        <TextField fx:id="txtfNombreProyecto" layoutX="118.0" layoutY="243.0" onAction="#validarProyecto" prefHeight="39.0" prefWidth="468.0" promptText="Ej: Chatbot para un sistema de paquetería">
            <font>
                <Font name="Gill Sans MT" size="18.0" />
            </font>
        </TextField>
        <Label layoutX="232.0" layoutY="185.0" text="Nombre del estudiante">
            <font>
                <Font name="Gill Sans MT" size="22.0" />
            </font>
        </Label>
        <Button layoutX="503.0" layoutY="384.0" mnemonicParsing="false" onAction="#clicBtnBuscar" prefHeight="47.0" prefWidth="124.0" style="-fx-background-color: #28ad56;" text="Aceptar" textFill="WHITE">
            <font>
                <Font name="Gill Sans MT" size="25.0" />
            </font>
        </Button>
        <Button layoutX="83.0" layoutY="384.0" mnemonicParsing="false" onAction="#clicBtnCancelar" style="-fx-background-color: #28ad56;" text="Cancelar" textFill="WHITE">
            <font>
                <Font name="Gill Sans MT" size="25.0" />
            </font>
        </Button>
        <Label fx:id="lbProyectoNoEncontrado" layoutX="118.0" layoutY="289.0" textFill="#18529d">
            <font>
                <Font name="Gill Sans MT" size="18.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
